VITE_PROXY_BASE_URL=http://localhost:3002
VITE_MARKET_DATA_PROVIDER=none
VITE_OPTIC_ODDS_API_KEY=
VITE_OPTIC_ODDS_SPORTSBOOKS=DraftKings,FanDuel,BetMGM,Caesars,Pinnacle
VITE_SPORTS_DATA_IO_API_KEY=

# ── NBA Automation Server ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mlb_predictor?schema=public"
NBA_API_PORT=8789
NBA_EXPORT_DIR="./generated/nba"
ENABLE_DB_PERSISTENCE=true
ENABLE_FALLBACK_MODE=true

# ── Odds Browser Capture (Playwright) ─────────────────────────────────────────
# Provider label written to the DB with each captured record
ODDS_CAPTURE_PROVIDER=betlotus-nba

# Base / login URL for the sportsbook
ODDS_CAPTURE_BASE_URL=
ODDS_CAPTURE_LOGIN_URL=

# URL to navigate to after login (leave blank if same page)
ODDS_CAPTURE_PAGE_URL=

# Credentials
ODDS_CAPTURE_USERNAME=
ODDS_CAPTURE_PASSWORD=

# CSS / XPath selectors (XPath must start with // or ())
ODDS_CAPTURE_LOGIN_FRAME_SELECTOR=
ODDS_CAPTURE_USERNAME_SELECTOR=
ODDS_CAPTURE_PASSWORD_SELECTOR=
ODDS_CAPTURE_SUBMIT_SELECTOR=
# Element that confirms successful login
ODDS_CAPTURE_SUCCESS_SELECTOR=
# Element whose innerText contains the odds to capture
ODDS_CAPTURE_CONTENT_SELECTOR=
# Optional: wait for this selector before reading content
ODDS_CAPTURE_READY_SELECTOR=
# Optional: dismiss a modal before navigating
ODDS_CAPTURE_MODAL_CLOSE_SELECTOR=

# Navigation clicks to reach the NBA odds page — pipe-separated (||)
# e.g. //a[text()='Sports']||//a[text()='NBA']
ODDS_CAPTURE_NAV_SELECTORS=

# JavaScript to eval after login if the page needs a client-side trigger
ODDS_CAPTURE_POST_LOGIN_SCRIPT=

# Timing
ODDS_CAPTURE_STEP_DELAY_MS=1000
ODDS_CAPTURE_TYPE_DELAY_MS=75
ODDS_CAPTURE_TIMEOUT_MS=45000

# Browser settings (leave BROWSER_CHANNEL blank for bundled Chromium)
ODDS_CAPTURE_BROWSER_CHANNEL=
ODDS_CAPTURE_HEADLESS=true
ODDS_CAPTURE_USER_AGENT=
